#!/bin/sh
# BEGIN Qoder AI tracker
previous_head="$1"
new_head="$2"
is_branch_checkout="$3"
case "$previous_head" in
  ''|*[!0]*) is_zero_head="0" ;;
  *) is_zero_head="1" ;;
esac
if [ "$is_branch_checkout" = "1" ] && [ "$previous_head" != "$new_head" ] && [ "$is_zero_head" = "0" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -W 2>/dev/null || pwd)"
  "/usr/bin/node" "/home/zysong/.qoder-cn/remote/protocol-v1/installs/0.3.3/linux-x64-gnu.1789732196.2047613/lib/qoder-worker-runtime/qoder-worker-runtime.obf.mjs" ai-code-tracking-hook post-checkout --workspace "$repo_root" --old-head "$previous_head" --new-head "$new_head" --is-branch "$is_branch_checkout" >/dev/null 2>&1 || true
fi
# END Qoder AI tracker
